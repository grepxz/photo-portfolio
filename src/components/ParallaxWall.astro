 * Fork of an original work by ol-ivier (https://codepen.io/ol-ivier/pen/LERzpKJ)
 *
 * Adapted for this site: photos come from the gallery manifest instead of
 * Unsplash, the wheel handlers are removed so the page scrolls normally, and
 * the render loop pauses when the hero leaves the viewport.
 */
import { getWallImages } from '../data/wallImages.ts';

const images = await getWallImages(50);

/* The wall starts as soon as a handful of textures are ready, so fetch those
   first few alongside the three.js bundle rather than waiting for it to parse. */
const preloaded = images.slice(0, 8);
---

{preloaded.map((image) => <link rel="preload" as="image" href={image.src} />)}

<!-- Plain white ground: what shows through the gaps between sprites, while
     textures load, and if WebGL is unavailable or motion is reduced. -->
<div id="parallax-wall" class="absolute inset-0 z-0 overflow-hidden bg-white select-none">
	<div
		id="wall-stage"
		class="absolute inset-0 opacity-0 transition-opacity duration-500"
		data-images={JSON.stringify(images)}
	>
	</div>
</div>

<script>
	// Types only - the library itself is imported dynamically below, so visitors
	// who never render the wall (reduced motion, no WebGL) never download it.
	import type * as ThreeTypes from 'three';

	interface WallImage {
		src: string;
		width: number;
		height: number;
	}

	interface SpriteData {
		speed: number;
		width: number;
		height: number;
		seed: number;
		baseY: number;
		opacity: number;
		layer: number;
		sizeVar: number;
	}

	const DEPTH_LAYERS = 5;
	const IMAGES_PER_LAYER = 10;
	const MAX_WIDTH = 160;
	const MAX_HEIGHT = 160;
	/* Start the wall once this many textures are ready; the rest stream in. */
	const MIN_TEXTURES_TO_START = 8;

	/* Per-layer depth cues: nearer layers are larger, faster and more opaque. */
	const LAYER_CONFIG = [
		{ scale: 1.5, speed: 80, opacity: 1.0 },
		{ scale: 1.0, speed: 40, opacity: 0.85 },
		{ scale: 0.8, speed: 30, opacity: 0.7 },
		{ scale: 0.6, speed: 20, opacity: 0.55 },
		{ scale: 0.5, speed: 15, opacity: 0.4 },
	];

	const stage = document.getElementById('wall-stage');
	if (stage) void initWall(stage);

	function prefersReducedMotion(): boolean {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	function supportsWebGL(): boolean {
		try {
			const canvas = document.createElement('canvas');
			return !!(canvas.getContext('webgl2') || canvas.getContext('webgl'));
		} catch {
			return false;
		}
	}

	async function initWall(container: HTMLElement) {
		// Leave the white ground in place for either of these - and, because the
		// import below is dynamic, without paying for three.js at all.
		if (prefersReducedMotion() || !supportsWebGL()) return;

		const imagePaths: WallImage[] = JSON.parse(container.dataset.images || '[]');
		if (imagePaths.length === 0) return;

		const THREE = await import('../lib/threeWall.ts');

		let layers: ThreeTypes.Sprite[][] = [];
		const textures: ThreeTypes.Texture[] = [];
		let camera: ThreeTypes.OrthographicCamera | null = null;
		let lastTime = 0;
		let speedFactor = 1;
		let dragVelocity = 0;
		let dragActive = false;
		let lastX = 0;
		let running = false;
		let frame = 0;
		let visible = true; // wall is on screen (IntersectionObserver)
		let ready = false; // camera built and sprites placed

		const scene = new THREE.Scene();
		const renderer = new THREE.WebGLRenderer({
			antialias: true,
			alpha: true,
			powerPreference: 'high-performance',
		});
		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
		renderer.setClearColor(0x000000, 0);
		container.appendChild(renderer.domElement);

		const rand = (min: number, max: number) => Math.random() * (max - min) + min;

		function shuffle<T>(input: T[]): T[] {
			const out = [...input];
			for (let i = out.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[out[i], out[j]] = [out[j], out[i]];
			}
			return out;
		}

		function fallbackTexture(layer: number): ThreeTypes.Texture {
			const c = document.createElement('canvas');
			c.width = MAX_WIDTH;
			c.height = MAX_HEIGHT;
			const ctx = c.getContext('2d')!;
			ctx.fillStyle = ['#4a6572', '#344955', '#232f34', '#1c2529', '#0f1518'][layer];
			ctx.fillRect(0, 0, c.width, c.height);
			return new THREE.CanvasTexture(c);
		}

		function disposeSprites() {
			for (const layer of layers) {
				for (const sprite of layer) {
					scene.remove(sprite);
					// Textures are shared between sprites, so they are never disposed
					// here - only the per-sprite material is.
					sprite.material.dispose();
				}
			}
			layers = Array.from({ length: DEPTH_LAYERS }, () => []);
		}

		function resize() {
			const w = container.clientWidth;
			const h = container.clientHeight;
			if (w === 0 || h === 0) return;
			renderer.setSize(w, h);
			if (!camera) {
				camera = new THREE.OrthographicCamera(0, w, h, 0, -1000, 1000);
				camera.position.z = 10;
			} else {
				camera.right = w;
				camera.top = h;
				camera.updateProjectionMatrix();
			}
			disposeSprites();
			if (textures.length > 0) fillViewport();
		}

		/** Sprite dimensions for a texture, preserving its aspect ratio. */
		function sizeFor(texture: ThreeTypes.Texture, layerIndex: number, sizeVar: number) {
			const cfg = LAYER_CONFIG[layerIndex];
			let width = MAX_WIDTH;
			let height = MAX_HEIGHT;
			const image = texture.image as { width?: number; height?: number } | undefined;
			if (image?.width && image?.height) {
				const ratio = image.width / image.height;
				if (ratio > 1) height = MAX_WIDTH / ratio;
				else width = MAX_HEIGHT * ratio;
			}
			return { w: width * cfg.scale * sizeVar, h: height * cfg.scale * sizeVar };
		}

		function addSprite(layerIndex: number, startX: number) {
			const cfg = LAYER_CONFIG[layerIndex];
			const texture = textures[Math.floor(Math.random() * textures.length)];
			const material = new THREE.SpriteMaterial({
				map: texture,
				transparent: true,
				opacity: cfg.opacity,
			});
			const sprite = new THREE.Sprite(material);

			const sizeVar = rand(0.85, 1.15);
			const { w, h } = sizeFor(texture, layerIndex, sizeVar);
			const spacing = w * rand(0.5, 0.9);

			sprite.scale.set(w, h, 1);
			sprite.position.set(
				startX + w / 2 + spacing,
				rand(h / 2, container.clientHeight - h / 2),
				-layerIndex * 50,
			);
			sprite.userData = {
				speed: cfg.speed * rand(0.45, 1.15),
				width: w,
				height: h,
				seed: rand(0, 1000),
				baseY: sprite.position.y,
				opacity: cfg.opacity,
				layer: layerIndex,
				sizeVar,
			} satisfies SpriteData;

			layers[layerIndex].push(sprite);
			scene.add(sprite);
		}

		/**
		 * Hands a late-arriving texture to a random sprite. The wall starts on a
		 * handful of images and gains variety as the rest download, instead of
		 * showing nothing until all 50 have arrived.
		 */
		function adoptTexture(texture: ThreeTypes.Texture) {
			const populated = layers.filter((l) => l.length > 0);
			if (populated.length === 0) return;
			const layer = populated[Math.floor(Math.random() * populated.length)];
			const sprite = layer[Math.floor(Math.random() * layer.length)];
			const ud = sprite.userData as SpriteData;

			sprite.material.map = texture;
			sprite.material.needsUpdate = true;

			// Re-derive the size: the new photo may have a different aspect ratio.
			const { w, h } = sizeFor(texture, ud.layer, ud.sizeVar);
			ud.width = w;
			ud.height = h;
			sprite.scale.set(w, h, 1);
		}

		function fillViewport() {
			const w = container.clientWidth;
			for (let l = 0; l < DEPTH_LAYERS; l++) {
				const sprites = layers[l];
				let rightMost =
					sprites.length > 0
						? Math.max(...sprites.map((s) => s.position.x + (s.userData as SpriteData).width / 2))
						: -w * 1.2;
				while (rightMost < w) {
					addSprite(l, rightMost);
					rightMost = Math.max(
						...sprites.map((s) => s.position.x + (s.userData as SpriteData).width / 2),
					);
				}
			}
		}

		function cleanupSprites() {
			const w = container.clientWidth;
			const buffer = w * 0.5;
			for (const sprites of layers) {
				const maxSprites = IMAGES_PER_LAYER + 3;
				if (sprites.length <= maxSprites) continue;
				for (let i = sprites.length - 1; i >= 0; i--) {
					const sprite = sprites[i];
					const ud = sprite.userData as SpriteData;
					const offRight = sprite.position.x - ud.width / 2 > w + buffer;
					const offLeft = sprite.position.x + ud.width / 2 < -buffer;
					if (speedFactor > 0 ? offRight : offLeft) {
						scene.remove(sprite);
						sprite.material.dispose();
						sprites.splice(i, 1);
						if (sprites.length <= maxSprites) break;
					}
				}
			}
		}

		function animate() {
			if (!running || !camera) return;
			frame = requestAnimationFrame(animate);

			const now = performance.now();
			const dt = Math.min(40, now - lastTime) / 1000;
			lastTime = now;
			const w = container.clientWidth;

			dragVelocity *= 0.92;
			if (dragVelocity !== 0) speedFactor = Math.sign(dragVelocity);
			if (Math.random() < 0.01) cleanupSprites();

			for (const sprites of layers) {
				for (const sprite of sprites) {
					const ud = sprite.userData as SpriteData;
					sprite.position.x += ud.speed * speedFactor * dt;

					// Recycle across the viewport for seamless infinite scrolling.
					if (speedFactor > 0 && sprite.position.x - ud.width / 2 > w) {
						sprite.position.x = -ud.width / 2 - rand(0, ud.width);
					} else if (speedFactor < 0 && sprite.position.x + ud.width / 2 < 0) {
						sprite.position.x = w + ud.width / 2 + rand(0, ud.width);
					}

					const pulse = 1 + Math.sin(now * 0.001 + ud.seed) * 0.015;
					sprite.scale.x = ud.width * pulse;
					sprite.scale.y = ud.height * pulse;
					sprite.position.y = ud.baseY + Math.sin(now * 0.001 + ud.seed) * 5;
				}
			}

			renderer.render(scene, camera);
		}

		/**
		 * The loop runs only when the wall is on screen, the tab is visible, and
		 * the scene is actually renderable. These arrive in any order - the
		 * observer fires before the first texture lands - so each input updates
		 * its own flag and defers the decision here, rather than calling a
		 * start() that cannot tell "asked to run" from "actually running".
		 */
		function syncLoop() {
			const shouldRun = visible && ready && !document.hidden;
			if (shouldRun === running) return;
			running = shouldRun;
			if (running) {
				lastTime = performance.now();
				animate();
			} else {
				cancelAnimationFrame(frame);
			}
		}

		/**
		 * Textures load in two phases. The first few are the preloaded ones,
		 * requested in order so the wall can start on images the browser already
		 * has. The remainder are deferred until the wall is running, so they do
		 * not compete with the three.js bundle for bandwidth, and are shuffled so
		 * the wall differs between visits.
		 */
		function loadTextures() {
			const loader = new THREE.TextureLoader();
			const total = Math.min(DEPTH_LAYERS * IMAGES_PER_LAYER, imagePaths.length);
			const headCount = Math.min(MIN_TEXTURES_TO_START, total);
			const head = imagePaths.slice(0, headCount);
			const tail = shuffle(imagePaths.slice(headCount)).slice(0, total - headCount);
			let started = false;
			let tailQueued = false;

			const onSettled = (texture: ThreeTypes.Texture) => {
				texture.colorSpace = THREE.SRGBColorSpace;
				textures.push(texture);

				if (!started && textures.length >= headCount) {
					started = true;
					resize();
					container.style.opacity = '1';
					ready = true;
					syncLoop();
					queueTail();
				} else if (started) {
					adoptTexture(texture);
				}
			};

			const request = (image: WallImage, index: number) =>
				loader.load(image.src, onSettled, undefined, () =>
					onSettled(fallbackTexture(index % DEPTH_LAYERS)),
				);

			function queueTail() {
				if (tailQueued || tail.length === 0) return;
				tailQueued = true;
				const run = () => tail.forEach((image, i) => request(image, headCount + i));
				if ('requestIdleCallback' in window) {
					window.requestIdleCallback(run, { timeout: 2000 });
				} else {
					setTimeout(run, 300);
				}
			}

			head.forEach(request);
		}

		/* Drag to browse, with inertia — a pointer affordance only. Listeners live
		   on the wall alone, so the overlaid hero card never drags the scene, and
		   there is no wheel handling: the page must keep scrolling normally.

		   Touch is deliberately excluded. The wall sits directly beneath the
		   page's main scroll path, and a swipe up a phone screen is never
		   perfectly vertical — its horizontal component used to spin the scene
		   while someone was only trying to scroll past it. The gesture to browse
		   and the gesture to leave were the same gesture.

		   The query tests the input device rather than the viewport, so a
		   touchscreen laptop is judged by the pointer actually in use instead of
		   by how wide its screen happens to be. Because no touch listener is
		   registered, the compatibility mouse events a phone synthesises on tap
		   have nothing to reach either. */
		const canDrag = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

		if (canDrag) {
			const beginDrag = (e: MouseEvent) => {
				dragActive = true;
				lastX = e.clientX;
			};
			const moveDrag = (e: MouseEvent) => {
				if (!dragActive) return;
				dragVelocity = (e.clientX - lastX) * 0.02;
				lastX = e.clientX;
			};
			const endDrag = () => {
				dragActive = false;
			};

			container.addEventListener('mousedown', beginDrag);
			container.addEventListener('mousemove', moveDrag);
			window.addEventListener('mouseup', endDrag);
		}

		window.addEventListener('resize', resize);

		/* Stop rendering whenever the hero is off-screen. */
		new IntersectionObserver(
			([entry]) => {
				visible = entry.isIntersecting;
				syncLoop();
			},
			{ threshold: 0 },
		).observe(container);

		document.addEventListener('visibilitychange', syncLoop);

		loadTextures();
	}
</script>
