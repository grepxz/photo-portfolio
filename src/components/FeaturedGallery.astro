---
import PhotoGrid from './PhotoGrid.astro';
import { featuredCollectionId, getImages } from '../data/imageStore';
import { localeFromPath, useTranslations } from '../i18n/index.ts';

const images = await getImages({ collection: featuredCollectionId });
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<div class="max-w-2xl mx-auto text-center mb-16">
	<h2 class="text-3xl md:text-4xl font-bold mb-4">{t.featured.works}</h2>
	<p class="text-gray-600 italic">
		{t.featured.subtitle}
	</p>
</div>
<div class="p-4">
	<PhotoGrid images={images} />
</div>
