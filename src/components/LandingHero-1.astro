---
import { localeFromPath, localePath, useTranslations } from '../i18n/index.ts';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<div class="absolute left-0 right-0 z-10 flex flex-col items-center px-4">
	<!-- Dictionary-entry card. Sits above the parallax wall; pointer events are
	     stopped here so dragging it never moves the scene behind. -->
	<div
		id="hero-card"
		class="max-w-xl rounded-lg border border-black/10 bg-[#faf9f6] px-6 py-5 text-left shadow-xl md:px-8 md:py-6"
	>
		<p class="text-4xl font-bold text-gray-900 md:text-5xl">{t.hero.word}</p>

		<p class="mt-2 text-sm text-gray-500 md:text-base">
			<span class="italic">{t.hero.partOfSpeech}</span>
			<span class="ml-1">{t.hero.countable}</span>
		</p>

		<!-- IPA sits outside Newsreader's glyph coverage, so give it an explicit
		     fallback rather than letting the browser pick per character. -->
		<p class="ipa mt-1 text-sm text-gray-400 md:text-base">{t.hero.ipa}</p>

		<hr class="my-3 border-black/10" />

		<p class="text-lg font-extralight italic text-gray-700 md:text-2xl">
			<span class="pr-1 font-normal text-gray-400 not-italic">1.</span>
			{t.hero.definition}
		</p>

		<!-- Attribution for the definition above. Carries the page's h1 — the only
		     place the site states plainly who Hanna is and where she works, so it
		     stays a heading no matter how quietly it is styled. -->
		<!-- text-gray-500, not 400: on this card's #faf9f6 the 400 shade is 2.47:1,
		     under the 4.5:1 WCAG AA needs for text this size. 500 is 4.59:1. -->
		<h1 class="mt-3 text-right text-xs font-normal text-gray-500 md:text-sm">
			{t.hero.attribution}
		</h1>
	</div>

	<a
		href={localePath('/collections/', locale)}
		class="mt-6 inline-block rounded-md border-2 border-black bg-white px-6 py-3 text-sm
                      font-normal text-black shadow-md transition-all duration-300
                      hover:bg-black hover:text-white md:text-base
                      transform hover:scale-105 active:scale-95"
	>
		{t.hero.viewGallery}
	</a>
</div>

<style>
	.ipa {
		font-family:
			'Charis SIL', 'Doulos SIL', 'Gentium Plus', 'Segoe UI', 'Lucida Sans Unicode', 'DejaVu Sans',
			sans-serif;
	}
</style>

<script>
	// Keep drags on the card from reaching the parallax wall underneath.
	const card = document.getElementById('hero-card');
	for (const type of ['mousedown', 'mousemove', 'touchstart', 'touchmove']) {
		card?.addEventListener(type, (e) => e.stopPropagation());
	}
</script>
