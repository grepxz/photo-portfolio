---
/**
 * Gives the homepage crawlable subject matter and internal links into the
 * collections. The parallax wall renders to a WebGL canvas, so without this the
 * page carries almost no indexable text.
 */
import { localeFromPath, useTranslations } from '../i18n/index.ts';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<section class="container-custom py-20">
	<div class="prose mx-auto max-w-2xl text-gray-700">
		<h2 class="reveal text-2xl md:text-3xl font-bold">{t.home.introHeading}</h2>
		{
			// Anchors inside this set:html content never receive the .reveal scope
			// attribute Astro puts on elements it can see in the template, so a
			// future rule targeting anchors within .reveal (e.g. `.reveal a`) would
			// not reach the links in these paragraphs.
			t.home.paragraphs.map((html) => <p class="reveal" set:html={html} />)
		}
	</div>
</section>

<style>
	/**
	 * Scroll-driven sequential reveal: each block fades up as it enters view,
	 * then sits as an ordinary paragraph column.
	 *
	 * This is the only crawlable text on the homepage, so it must never be
	 * possible for it to end up permanently invisible. Three guards:
	 *
	 * 1. No JavaScript. A scroll listener that fails to attach would leave the
	 *    text at opacity 0 forever; a CSS animation cannot fail that way.
	 * 2. The hidden start state lives INSIDE @supports, so a browser without
	 *    animation-timeline never hides what it has no way to reveal. The base
	 *    state of every .reveal is fully visible.
	 * 3. prefers-reduced-motion opts out completely — vestibular disorders make
	 *    movement-on-scroll genuinely unpleasant, not just a taste question.
	 *
	 * The range completes early (by 28% of the way through the element's pass
	 * across the viewport) so text is solid well before it reaches reading
	 * position, rather than still fading while someone is trying to read it.
	 */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.reveal {
				animation: reveal-in linear both;
				animation-timeline: view();
				animation-range: entry 10% cover 28%;
			}
		}
	}

	@keyframes reveal-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
