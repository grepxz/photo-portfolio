---
/**
 * Gives the homepage crawlable subject matter and internal links into the
 * collections. The parallax wall renders to a WebGL canvas, so without this the
 * page carries almost no indexable text.
 */
import { localeFromPath, useTranslations } from '../i18n/index.ts';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

/**
 * Paragraphs carry inline links as HTML (see i18n/types.ts). Rendering that
 * HTML with set:html would leave the anchors outside Astro's scoped-style
 * pass — they'd never pick up the .reveal scope attribute the way every
 * other element in this file does. Splitting into text/link segments and
 * rendering the links as ordinary elements keeps them scoped like everything
 * else, with the same hrefs and text the dictionary provides.
 */
type Segment = string | { href: string; text: string };

const toSegments = (html: string): Segment[] => {
	const pattern = /<a href="([^"]*)">([^<]*)<\/a>/g;
	const segments: Segment[] = [];
	let cursor = 0;
	let match = pattern.exec(html);
	while (match !== null) {
		if (match.index > cursor) segments.push(html.slice(cursor, match.index));
		segments.push({ href: match[1], text: match[2] });
		cursor = match.index + match[0].length;
		match = pattern.exec(html);
	}
	if (cursor < html.length) segments.push(html.slice(cursor));
	return segments;
};
---

<section class="container-custom py-20">
	<div class="prose mx-auto max-w-2xl text-gray-700">
		<h2 class="reveal text-2xl md:text-3xl font-bold">{t.home.introHeading}</h2>
		{
			// Adjacent literal <p> siblings in a template pick up a whitespace text
			// node between them; sibling elements returned from one expression's
			// array do not. The interleaved ' ' reproduces that separator so the
			// only differences left are the insignificant ones Astro already made.
			t.home.paragraphs.flatMap((html, i) => {
				const paragraph = (
					<p class="reveal">
						{toSegments(html).map((segment) =>
							typeof segment === 'string' ? (
								<Fragment set:html={segment} />
							) : (
								<a href={segment.href} set:html={segment.text} />
							),
						)}
					</p>
				);
				return i === 0 ? [paragraph] : [' ', paragraph];
			})
		}
	</div>
</section>

<style>
	/**
	 * Scroll-driven sequential reveal: each block fades up as it enters view,
	 * then sits as an ordinary paragraph column.
	 *
	 * This is the only crawlable text on the homepage, so it must never be
	 * possible for it to end up permanently invisible. Three guards:
	 *
	 * 1. No JavaScript. A scroll listener that fails to attach would leave the
	 *    text at opacity 0 forever; a CSS animation cannot fail that way.
	 * 2. The hidden start state lives INSIDE @supports, so a browser without
	 *    animation-timeline never hides what it has no way to reveal. The base
	 *    state of every .reveal is fully visible.
	 * 3. prefers-reduced-motion opts out completely — vestibular disorders make
	 *    movement-on-scroll genuinely unpleasant, not just a taste question.
	 *
	 * The range completes early (by 28% of the way through the element's pass
	 * across the viewport) so text is solid well before it reaches reading
	 * position, rather than still fading while someone is trying to read it.
	 */
	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.reveal {
				animation: reveal-in linear both;
				animation-timeline: view();
				animation-range: entry 10% cover 28%;
			}
		}
	}

	@keyframes reveal-in {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
