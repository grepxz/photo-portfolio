---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as BookPage } from '../content/book.md';
import siteConfig from '../../site.config.mjs';

const profileImage = siteConfig.profileImage;
const base = import.meta.env.BASE_URL;
---

<MainLayout>
	<section class="pt-32 pb-20">
		<div class="container-custom">
			<div class="max-w-2xl mx-auto text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-bold mb-4">Book Me</h1>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div>
					<img
						src=`${base}/images/${profileImage}`
						alt="Profile image"
						class="w-full h-auto rounded-lg shadow-lg border-8 my-4 border-white md:p-4"
						width="720"
						height="720"
					/>
				</div>

				<div class="prose text-gray-700 mb-6">
					<BookPage />

					<div class="flex flex-wrap gap-4 mt-8 not-prose">
						<a
							href="https://www.airbnb.com/experiences/REPLACE_ME"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block px-6 py-3 bg-black text-white border-2 border-black rounded-md hover:bg-white hover:text-black transition-all duration-300 text-sm md:text-base font-medium transform hover:scale-105 active:scale-95"
						>
							 Book my service
						</a>
						<a
							href="mailto:REPLACE_ME@example.com?subject=Photography%20Booking%20Inquiry"
							class="inline-block px-6 py-3 bg-white text-black border-2 border-black rounded-md hover:bg-black hover:text-white transition-all duration-300 text-sm md:text-base font-medium transform hover:scale-105 active:scale-95"
						>
							Book through Email
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</MainLayout>
