---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as BookPageEn } from '../content/book.md';
import { Content as BookPageEs } from '../content/book.es.md';
import CalBooking from '../components/CalBooking.astro';
import siteConfig from '../../site.config.mjs';
import { localeFromPath, useTranslations } from '../i18n/index.ts';

const profileImage = siteConfig.profileImage;
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const BookPage = locale === 'es' ? BookPageEs : BookPageEn;
const bookEmailHref = `mailto:nyzhniah@gmail.com?subject=${encodeURIComponent(t.book.emailSubject)}`;
---

<MainLayout
	title={t.meta.book.title}
	description={t.meta.book.description}
	availableLocales={['en', 'es']}
>
	<section class="pt-32 pb-20">
		<div class="container-custom">
			<div class="max-w-2xl mx-auto text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-bold mb-4">{t.book.heading}</h1>
			</div>

			<!-- items-start, not items-center: the bio column grew when the TFP section
			     landed, and centring left the portrait floating against a much taller
			     block of text. The portrait now sets against the first line of it. -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-10 lg:gap-y-8 items-start">
				<div class="lg:col-start-1 lg:row-start-1">
					<img
						src=`/images/${profileImage}`
						alt={t.book.profileAlt}
						class="w-full h-auto rounded-lg shadow-lg"
						width="1200"
						height="1200"
					/>
				</div>

				<!-- text-pretty is the web's actual orphan/widow control: the browser
				     looks ahead over the last few lines and rebalances so no line is
				     left with a single stranded word. The CSS `orphans`/`widows`
				     properties do nothing here — they only apply to paged and
				     multi-column layouts. text-balance on headings keeps short
				     headings from breaking one word onto a second line. Text stays
				     ragged-right rather than justified, which is what prevents rivers;
				     justification is what causes them. -->
				<div
					class="prose prose-p:text-pretty prose-li:text-pretty prose-headings:text-balance text-gray-700 lg:col-start-2 lg:row-start-1"
				>
					<BookPage />
				</div>

				<div class="flex flex-wrap gap-4 lg:col-start-2 lg:row-start-2">
					<CalBooking />
					<a
						href="https://www.airbnb.com/services/7039055?s=67&unique_share_id=790ce471-3112-442f-850a-9133d39f94c3"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block px-6 py-3 bg-black text-white border-2 border-black rounded-md hover:bg-white hover:text-black transition-all duration-300 text-sm md:text-base font-normal transform hover:scale-105 active:scale-95"
					>
						{t.book.bookService}
					</a>
					<a
						href={bookEmailHref}
						class="inline-block px-6 py-3 bg-white text-black border-2 border-black rounded-md hover:bg-black hover:text-white transition-all duration-300 text-sm md:text-base font-normal transform hover:scale-105 active:scale-95"
					>
						{t.book.bookEmail}
					</a>
				</div>
			</div>
		</div>
	</section>
</MainLayout>
