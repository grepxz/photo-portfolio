---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as BookPage } from '../content/book.md';
import CalBooking from '../components/CalBooking.astro';
import siteConfig from '../../site.config.mjs';

const profileImage = siteConfig.profileImage;
---

<MainLayout
	title="Book a Photographer in Barcelona"
	description="Book Hanna for weddings, events, portraits and documentary work in Barcelona. Reduced rates and TFP available for selected shoot types."
>
	<section class="pt-32 pb-20">
		<div class="container-custom">
			<div class="max-w-2xl mx-auto text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-bold mb-4">Book Me</h1>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-10 lg:gap-y-8 items-center">
				<div class="lg:col-start-1 lg:row-start-1">
					<img
						src=`/images/${profileImage}`
						alt="Hanna editing a photograph in DaVinci Resolve"
						class="w-full h-auto rounded-lg shadow-lg"
						width="1124"
						height="1019"
					/>
				</div>

				<div class="prose text-gray-700 lg:col-start-2 lg:row-start-1">
					<BookPage />
				</div>

				<div class="flex flex-wrap gap-4 lg:col-start-2 lg:row-start-2">
					<CalBooking />
					<a
						href="https://www.airbnb.com/services/7039055?s=67&unique_share_id=790ce471-3112-442f-850a-9133d39f94c3"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-block px-6 py-3 bg-black text-white border-2 border-black rounded-md hover:bg-white hover:text-black transition-all duration-300 text-sm md:text-base font-normal transform hover:scale-105 active:scale-95"
					>
						Book my service
					</a>
					<a
						href="mailto:nyzhniah@gmail.com?subject=Photography%20Booking%20Inquiry"
						class="inline-block px-6 py-3 bg-white text-black border-2 border-black rounded-md hover:bg-black hover:text-white transition-all duration-300 text-sm md:text-base font-normal transform hover:scale-105 active:scale-95"
					>
						Book through Email
					</a>
				</div>
			</div>
		</div>
	</section>
</MainLayout>
